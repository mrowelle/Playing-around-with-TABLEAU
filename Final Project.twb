            <column caption='CY Total Sales' datatype='real' name='[Calculation_3043307497839656980]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Order Date] &lt;= [Calculation_3043307497838043152] AND [Order Date] &gt;= [Calculation_3043307497838845970] THEN Sales ELSE 0 END' />
