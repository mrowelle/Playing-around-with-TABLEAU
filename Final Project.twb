      <aliases enabled='yes' />
      <column caption='Profit Ratio' datatype='real' name='[Calculation_3043307497134325760]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Profit])/SUM([Sales])' />
      </column>
      <column caption='Sales Per Customer' datatype='real' name='[Calculation_3043307497134628865]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Segment]:AVG([Discount])}' />
      </column>
      <column caption='Sub Region (ammended)' datatype='string' name='[Calculation_3043307497417842690]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Subregion]&#10;    WHEN &quot;NAMER&quot; THEN &quot;North America Region&quot;&#10;    WHEN &quot;LATAM&quot; THEN &quot;Latin America&quot;&#10;    WHEN &quot;APAC&quot; THEN &quot;Asia-Pacific&quot;&#10;    WHEN &quot;IND&quot; THEN &quot;India&quot;&#10;    WHEN &quot;ANZ&quot; THEN &quot;Australia and New Zealand&quot;&#10;    WHEN &quot;JAPN&quot; THEN &quot;Japan&quot;&#10;    WHEN &quot;UKIR&quot; THEN &quot;United Kingdom &amp; Ireland&quot;&#10;    WHEN &quot;NOR&quot; THEN &quot;Nordic Region&quot;&#10;    WHEN &quot;MEA&quot; THEN &quot;Middle East &amp; Africa&quot;&#10;    WHEN &quot;EU&quot; THEN &quot;European Union&quot;&#10;    WHEN &quot;EU-WEST&quot; THEN &quot;Western Europe&quot;&#10;    WHEN &quot;EU-EAST&quot; THEN &quot;Eastern Europe&quot;&#10;    ELSE NULL&#10;END' />
      </column>
      <column caption='LOD for Quantity' datatype='integer' name='[Calculation_3043307497544482819]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Region], [Product]: SUM([Quantity])}' />
      </column>
      <column caption='LOD for Profit' datatype='real' name='[Calculation_3043307497544781828]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Region], [Product]: SUM([Profit])}' />
      </column>
      <column caption='Rank by Profit Ratio' datatype='integer' name='[Calculation_3043307497826525195]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK_DENSE([Calculation_3043307497134325760])'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Filter by Top N' datatype='string' name='[Calculation_3043307497829720077]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_3043307497826525195] &lt;= [Parameters].[Parameter 1]&#10;THEN &quot;Show&quot;&#10;ELSE &quot;Hide&quot;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Most Recent Date' datatype='date' name='[Calculation_3043307497838043152]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{MAX([Order Date])}' />
      </column>
      <column caption='Most Recent Date PY' datatype='date' name='[Calculation_3043307497838460945]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(DATEADD(&quot;year&quot;, -1, [Calculation_3043307497838043152]))' />
      </column>
      <column caption='Jan 1 CY' datatype='date' name='[Calculation_3043307497838845970]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(DATETRUNC(&quot;year&quot;, [Calculation_3043307497838043152]))' />
      </column>
      <column caption='Jan 1 PY' datatype='date' name='[Calculation_3043307497839083539]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(DATETRUNC(&quot;year&quot;, [Calculation_3043307497838460945]))' />
      </column>
      <column caption='CY Total Sales' datatype='real' name='[Calculation_3043307497839656980]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Order Date] &lt;= [Calculation_3043307497838043152] AND [Order Date] &gt;= [Calculation_3043307497838845970] THEN Sales ELSE 0 END' />
      </column>
      <column caption='PY Total Sales' datatype='real' name='[Calculation_3043307497840599061]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Order Date] &lt;= [Calculation_3043307497838460945] AND [Order Date] &gt;= [Calculation_3043307497839083539] THEN Sales ELSE 0 END' />
      </column>
      <column caption='Y to Y Sales Arrow' datatype='string' name='[Calculation_3043307497849503766]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([Calculation_3043307497866440732]) &gt; SUM([Calculation_3043307497866805277]) THEN &quot;▲&quot; &#10;ELSEIF SUM([Calculation_3043307497866440732]) &lt; SUM([Calculation_3043307497866805277]) THEN &quot;▼&quot;&#10;ELSE &quot;▬&quot;&#10;END' />
      </column>
      <column caption='Current Year Sales' datatype='real' name='[Calculation_3043307497866440732]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF YEAR([Order Date]) = [Parameters].[Parameter 2] THEN [Sales]&#10;ELSE 0&#10;END' />
      </column>
      <column caption='Prior Year Sales' datatype='real' name='[Calculation_3043307497866805277]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF YEAR([Order Date]) = [Parameters].[Parameter 2] - 1 THEN [Sales]&#10;ELSE 0&#10;END' />
      </column>
      <column caption='Current Year Profit' datatype='real' name='[Calculation_3043307497871732766]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF YEAR([Order Date]) = [Parameters].[Parameter 2] THEN [Profit]&#10;ELSE 0&#10;END' />
      </column>
      <column caption='Prior Year Profit' datatype='real' name='[Calculation_3043307497872924704]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF YEAR([Order Date]) = [Parameters].[Parameter 2] - 1 THEN Profit&#10;ELSE 0&#10;END' />
      </column>
      <column caption='Y to Y Profit Arrow' datatype='string' name='[Calculation_3043307497873018913]' role='measure' type='nominal'>
