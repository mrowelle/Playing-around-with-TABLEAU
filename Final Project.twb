            <column caption='PY Total Sales' datatype='real' name='[Calculation_3043307497840599061]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Order Date] &lt;= [Calculation_3043307497838460945] AND [Order Date] &gt;= [Calculation_3043307497839083539] THEN Sales ELSE 0 END' />
            </column>
            <column datatype='date' name='[Order Date]' role='dimension' type='ordinal' />
            <column datatype='string' name='[Region]' role='dimension' type='nominal' />
            <column datatype='real' name='[Sales]' role='measure' type='quantitative' />
            <column datatype='string' name='[Subregion]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_3043307497839656980]' derivation='Sum' name='[sum:Calculation_3043307497839656980:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_3043307497840599061]' derivation='Sum' name='[sum:Calculation_3043307497840599061:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Order Date]' derivation='Year' name='[yr:Order Date:ok]' pivot='key' type='ordinal' />
