    <worksheet name='Profit Card'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='SaaS-Sales' name='federated.1p1yqy01kzlkwz192v8xd17vs9hb' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Select Year' datatype='integer' default-format='n0;-0' name='[Parameter 2]' param-domain-type='list' role='measure' type='quantitative' value='2020'>
              <calculation class='tableau' formula='2020' />
              <aliases>
                <alias key='2021' value='2021' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1p1yqy01kzlkwz192v8xd17vs9hb'>
            <column caption='Sub Region (ammended)' datatype='string' name='[Calculation_3043307497417842690]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Subregion]&#10;    WHEN &quot;NAMER&quot; THEN &quot;North America Region&quot;&#10;    WHEN &quot;LATAM&quot; THEN &quot;Latin America&quot;&#10;    WHEN &quot;APAC&quot; THEN &quot;Asia-Pacific&quot;&#10;    WHEN &quot;IND&quot; THEN &quot;India&quot;&#10;    WHEN &quot;ANZ&quot; THEN &quot;Australia and New Zealand&quot;&#10;    WHEN &quot;JAPN&quot; THEN &quot;Japan&quot;&#10;    WHEN &quot;UKIR&quot; THEN &quot;United Kingdom &amp; Ireland&quot;&#10;    WHEN &quot;NOR&quot; THEN &quot;Nordic Region&quot;&#10;    WHEN &quot;MEA&quot; THEN &quot;Middle East &amp; Africa&quot;&#10;    WHEN &quot;EU&quot; THEN &quot;European Union&quot;&#10;    WHEN &quot;EU-WEST&quot; THEN &quot;Western Europe&quot;&#10;    WHEN &quot;EU-EAST&quot; THEN &quot;Eastern Europe&quot;&#10;    ELSE NULL&#10;END' />
            </column>
            <column caption='Current Year Profit' datatype='real' name='[Calculation_3043307497871732766]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF YEAR([Order Date]) = [Parameters].[Parameter 2] THEN [Profit]&#10;ELSE 0&#10;END' />
            </column>
            <column caption='Prior Year Profit' datatype='real' name='[Calculation_3043307497872924704]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF YEAR([Order Date]) = [Parameters].[Parameter 2] - 1 THEN Profit&#10;ELSE 0&#10;END' />
            </column>
            <column caption='Y to Y Profit Arrow' datatype='string' name='[Calculation_3043307497873018913]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF SUM([Calculation_3043307497871732766]) &gt; SUM([Calculation_3043307497872924704]) THEN &quot;▲&quot; &#10;ELSEIF SUM([Calculation_3043307497871732766]) &lt; SUM([Calculation_3043307497872924704]) THEN &quot;▼&quot;&#10;ELSE &quot;▬&quot; &#10;END' />
            </column>
            <column datatype='date' name='[Order Date]' role='dimension' type='ordinal' />
            <column datatype='real' name='[Profit]' role='measure' type='quantitative' />
            <column datatype='string' name='[Region]' role='dimension' type='nominal' />
            <column datatype='string' name='[Subregion]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_3043307497871732766]' derivation='Sum' name='[sum:Calculation_3043307497871732766:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_3043307497873018913]' derivation='User' name='[usr:Calculation_3043307497873018913:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
